[Unit]
Description=SAP AI Core Proxy Server
After=network.target

[Service]
User=pooky
Group=pooky
WorkingDirectory=/home/pooky/code/sap-ai-core-proxy
ExecStart=/home/pooky/code/sap-ai-core-proxy/sap-ai-core-proxy
EnvironmentFile=/home/pooky/code/sap-ai-core-proxy/.env
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
